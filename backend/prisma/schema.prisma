generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model CategoryType {
  id    String @id @default(uuid())
  code  String @unique
  label String

  categories Category[]
}

model Category {
  id   String @id @default(uuid())
  code String @unique
  name String

  typeId String?
  type   CategoryType? @relation(fields: [typeId], references: [id])

  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  createdAt   DateTime @default(now())

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  orderItems OrderItem[]
}

model Customer {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String?
  email       String?
  address     String?
  companyName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders   Order[]
  invoices Invoice[]
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELED
  FULFILLED
}

model Order {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  invoice Invoice?

  status   OrderStatus @default(DRAFT)
  currency String      @default("USD")

  subtotal      Decimal @default(0)
  taxTotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  total         Decimal @default(0)

  notes String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  quantity Int

  // Snapshots (freeze data at purchase time)
  name        String
  description String?
  unitPrice   Decimal
  lineTotal   Decimal

  categoryName String?
  categoryCode String?
  typeLabel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

enum InvoiceStatus {
  DRAFT
  SENDING
  SENT
  PAID
  OVERDUE
  FAILED
}

model Invoice {
  id String @id @default(uuid())

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status   InvoiceStatus @default(DRAFT)
  currency String        @default("USD")

  subtotal      Decimal @default(0)
  taxTotal      Decimal @default(0)
  discountTotal Decimal @default(0)
  total         Decimal @default(0)

  invoiceNumber String?   @unique
  issuedAt      DateTime  @default(now())
  dueDate       DateTime?

  pdfUrl    String?
  lastError String?

  items InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  name        String
  description String?
  quantity    Int
  unitPrice   Decimal
  lineTotal   Decimal

  categoryName String?
  categoryCode String?
  typeLabel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
}
